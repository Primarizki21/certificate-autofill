APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/certautofill
PROCESSING_MODE=background
DB_WORKER_POLL_SECONDS=2
MAX_UPLOAD_SIZE_MB=10
MIN_TEXT_LENGTH=80
ENABLE_OCR_FALLBACK=true
MAX_JOB_RETRIES=3

# Tesseract-to-Gemini Direct Extraction Pipeline (Option A)
# Default true per user request, set false to disable and fallback to offline rules
ENABLE_TESSERACT_GEMINI=true
GOOGLE_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30.0
