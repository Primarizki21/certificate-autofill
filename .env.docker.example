APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/certautofill
PROCESSING_MODE=background
DB_WORKER_POLL_SECONDS=1
WORKER_CONCURRENCY=2
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
MAX_UPLOAD_SIZE_MB=25
MIN_TEXT_LENGTH=80
ENABLE_OCR_FALLBACK=true
# NC-001: 2-pass nomor (disagreement). Default false: diukur lazy=0 gain; penuh +2-10s/cert utk +3pt.
ENABLE_OCR_NUMBER_2PASS=false
# EXP-OCR-LATENCY-001: thread ONNX RapidOCR (0 = ikuti kuota CPU container, -1 = default library).
OCR_RAPID_THREADS=0
MAX_JOB_RETRIES=3
UPLOAD_TEMP_DIR=/tmp/cert_uploads
TEMP_FILE_TTL_HOURS=1
JOB_LEASE_SECONDS=900
STORAGE_CLEANUP_INTERVAL_SECONDS=300

# Proteksi Unggahan & Pertahanan Memori (Defense-in-Depth)
RATE_LIMIT_PER_MINUTE=30
MAX_PDF_PAGES=3
MAX_IMAGE_PIXELS=60000000
MAX_IMAGE_DIMENSION=8000
MIN_IMAGE_DIMENSION=300
AUTO_DOWNSCALE_THRESHOLD=3500
AUTO_DOWNSCALE_TARGET=2500
MAX_PDF_CANVAS_DIMENSION=5000
# KHP master-aware mapping aktif di produksi.
ENABLE_KHP_MASTER_STAGING=true
KHP_AUCC_SQL_PATH=khp/aucc.sql

# Pipeline ekstraksi langsung Tesseract ke Gemini (Option A).
# Default aktif; ubah ke false untuk ekstraksi offline.
ENABLE_TESSERACT_GEMINI=true
# Combined v4.2 menjadi fallback offline saat Gemini gagal/nonaktif.
ENABLE_COMBINED_V4_2=true
GOOGLE_API_KEY=""
GOOGLE_GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30.0

# Admin Basic Auth (/api/admin/*)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=""  # Wajib diisi password yang kuat dan unik (jangan gunakan password default di server/publik)

# API Key Authentication for /api/v1/extract (prefix sk-, empty for open/internal mode)
API_KEYS=""
REQUIRE_API_KEY=false

# Port Host (Opsional, berguna jika menjalankan beberapa worktree sekaligus)
# POSTGRES_PORT=5434
# BACKEND_PORT=8000
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# LOKI_PORT=3100
