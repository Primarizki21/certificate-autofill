APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/certautofill
PROCESSING_MODE=background
DB_WORKER_POLL_SECONDS=2
MAX_UPLOAD_SIZE_MB=25
MIN_TEXT_LENGTH=80
ENABLE_OCR_FALLBACK=true
MAX_JOB_RETRIES=3
UPLOAD_TEMP_DIR=/tmp/cert_uploads
TEMP_FILE_TTL_HOURS=1
JOB_LEASE_SECONDS=900
STORAGE_CLEANUP_INTERVAL_SECONDS=300
# KHP master-aware mapping aktif di produksi.
ENABLE_KHP_MASTER_STAGING=true

# Pipeline ekstraksi langsung Tesseract ke Gemini (Option A).
# Default aktif; ubah ke false untuk ekstraksi offline.
ENABLE_TESSERACT_GEMINI=true
# Combined v4.2 menjadi fallback offline saat Gemini gagal/nonaktif.
ENABLE_COMBINED_V4_2=true
GOOGLE_API_KEY=""
GOOGLE_GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30.0

# Admin Export Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# API Key Authentication for /api/v1/extract (prefix sk-, empty for open/internal mode)
API_KEYS=""
REQUIRE_API_KEY=false

# Port Host (Opsional, berguna jika menjalankan beberapa worktree sekaligus)
# POSTGRES_PORT=5434
# BACKEND_PORT=8000
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# LOKI_PORT=3100
