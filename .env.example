APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:changeme@127.0.0.1:5434/certautofill
PROCESSING_MODE=background
MAX_UPLOAD_SIZE_MB=10
MIN_TEXT_LENGTH=80
ENABLE_DOCLING=true
ENABLE_OCR_FALLBACK=true
MAX_JOB_RETRIES=3
# v8: tingkat via LLM (Ollama). Default false agar produksi tetap deterministik.
ENABLE_LLM_TINGKAT=false
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
