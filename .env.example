APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:changeme@127.0.0.1:5434/certautofill
PROCESSING_MODE=background
MAX_UPLOAD_SIZE_MB=10
MIN_TEXT_LENGTH=80
ENABLE_DOCLING=true
ENABLE_OCR_FALLBACK=true
# NC-001: 2-pass nomor (disagreement). Default false — diukur lazy=0 gain; penuh +2-10s/cert utk +3pt.
ENABLE_OCR_NUMBER_2PASS=false
MAX_JOB_RETRIES=3
# v8: tingkat via LLM (Ollama). Default false agar produksi tetap deterministik.
ENABLE_LLM_TINGKAT=false
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Tesseract-to-Gemini Direct Extraction Pipeline (EXP-LLM-002: Option A)
# Default true per user request, set false to disable and fallback to offline rules
ENABLE_TESSERACT_GEMINI=true
GOOGLE_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30.0
